NODE_ENV=development

# API
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
JWT_SECRET=change-this-long-random-secret-before-production
JWT_EXPIRES_IN=7d

# GitHub release automation. Keep the token only on the API host.
TEMPEST_LIGHT_DEVELOPER_EMAILS=rafaeltanki1212@gmail.com
TEMPEST_LIGHT_GITHUB_REPOSITORY=medievalcraftequipe-dot/Medieval-Craft
TEMPEST_LIGHT_RELEASE_WORKFLOW_ID=release.yml
TEMPEST_LIGHT_RELEASE_REF=main
TEMPEST_LIGHT_GITHUB_TOKEN=

# Leave SMTP_HOST empty in development to print the activation link in the API logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Tempest Light Dev <no-reply@tempest-light.local>

# Database and cache
DATABASE_URL=postgresql://tempest_light:tempest_light_dev_password@localhost:5432/tempest_light?schema=public
REDIS_URL=redis://localhost:6379

# Object storage compatible with S3/R2/MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=tempest-light-media
S3_ACCESS_KEY=tempest_light
S3_SECRET_KEY=tempest_light_dev_password

# Web apps
VITE_API_URL=http://localhost:4000/api/v1
