NODE_ENV=production

# Domains configured in your DNS.
APP_DOMAIN=app.seu-dominio.com
API_DOMAIN=api.seu-dominio.com
PUBLIC_WEB_URL=https://app.seu-dominio.com
API_BASE_URL=https://api.seu-dominio.com
VITE_API_URL=https://api.seu-dominio.com/api/v1
CORS_ORIGIN=https://app.seu-dominio.com

# API
PORT=4000
JWT_SECRET=generate-a-long-random-secret-before-deploying
JWT_EXPIRES_IN=7d

# GitHub release automation. Keep the token only on the API host.
TEMPEST_LIGHT_DEVELOPER_EMAILS=rafaeltanki1212@gmail.com
TEMPEST_LIGHT_GITHUB_REPOSITORY=medievalcraftequipe-dot/Medieval-Craft
TEMPEST_LIGHT_RELEASE_WORKFLOW_ID=release.yml
TEMPEST_LIGHT_RELEASE_REF=main
TEMPEST_LIGHT_GITHUB_TOKEN=

# Email activation. Fill these with the SMTP account from your host/email provider.
SMTP_HOST=smtp.seu-dominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@seu-dominio.com
SMTP_PASS=replace-with-the-email-password
SMTP_FROM=Tempest Light <no-reply@seu-dominio.com>

# PostgreSQL
POSTGRES_USER=tempest_light
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=tempest_light
DATABASE_URL=postgresql://tempest_light:replace-with-a-strong-database-password@postgres:5432/tempest_light?schema=public

# Redis
REDIS_URL=redis://redis:6379

# S3-compatible object storage. This first production compose uses MinIO internally.
MINIO_ROOT_USER=tempest_light
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
S3_ENDPOINT=http://minio:9000
S3_REGION=local
S3_BUCKET=tempest-light-media
S3_ACCESS_KEY=tempest_light
S3_SECRET_KEY=replace-with-a-strong-minio-password
