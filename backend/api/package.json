{
  "name": "@tempest-light/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "shard:start": "npm run build && node scripts/shard-start.cjs",
    "test": "vitest run",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.0.5",
    "prisma": "6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "typescript": "5.7.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
